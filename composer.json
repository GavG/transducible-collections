{
    "name": "gavg/transducible-collections",
    "description": "Transducing for Illuminate Support collections.",
    "keywords": [
        "laravel",
        "collection"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "GavG",
            "email": "gavg.apps@gmail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/support": "^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "larastan/larastan": "^2.0|^3.0",
        "orchestra/testbench": "^9.0|^10.0",
        "pestphp/pest": "^2.0|^3.0",
        "pestphp/pest-plugin-laravel": "^2.0|^3.0",
        "phpstan/phpstan": "^2.0",
        "squizlabs/php_codesniffer": "^3.10"
    },
    "autoload": {
        "psr-4": {
            "GavG\\TransducibleCollections\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "GavG\\TransducibleCollections\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "GavG\\TransducibleCollections\\TransducibleCollectionsServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "./dev/test.sh",
        "cs": "phpcs --standard=PSR12 src/",
        "cs-fix": "phpcbf --standard=PSR12 src/",
        "analyse": "phpstan analyse"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}